{
    "keyboard_name": "Kunlun",
    "manufacturer": "YDKB_KBDFans x project 802",
    "maintainer": "project802",
    "bootloader_instructions ": "",
    "processor": "STM32F072",
    "bootloader": "stm32-dfu",
     "features": {
        "unicode": true,
        "bootmagic": true,
        "mousekey": true,
        "extrakey": true,
        "nkro": true,
        "rgblight": true,
        "combos": true,
        "tapdance": true
    },
    "qmk": {
        "locking": {
            "enabled": false,
            "resync": false
        }
    },
    "tapping": {
        "tapping_term": 200,
        "tapping_toggle": 1
    },
    "mouse_key": {
        "enabled": true,
        "interval": 20,
        "delay": 0,
        "time_to_max": 60,
        "max_speed": 7,
        "wheel_delay": 0
    },
    "rgblight": {
        "led_count": 3,
        "animations": {
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "breathing": true,
            "snake": true,
            "knight": true,
            "christmas": true,
            "static_gradient": true,
            "rgb_test": true,
            "alternating": true,
            "twinkle": true
        },
        "layers": {
            "enabled": true,
            "max": 4
        },
        "default": {
            "animation": "rainbow_mood",
            "speed": 3
        },
        "saturation_steps": 8,
        "brightness_steps": 8,
        "sleep": true
    },
    "ws2812": {
        "pin": "A3"
    },
    "audio": {
        "driver": "pwm_software",
        "pins": ["A8"]
    },
    "usb": {
        "vid": "0x9D5B",
        "pid": "0x2264",
        "device_version": "1.0.0"
